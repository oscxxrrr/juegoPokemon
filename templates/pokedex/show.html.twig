{% extends 'base.html.twig' %}

{% block title %}Pokedex{% endblock %}

{% block body %}
    <h1>Pokedex</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ pokedex.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ pokedex.name }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td><img src="{{ ('/uploads/' ~ pokedex.image) }}" alt="" width="120" height="80"></td>
            </tr>
            <tr>
                <th>Number</th>
                <td>{{ pokedex.number }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pokedex_index') }}">back to list</a>
    <br><br>
    <a href="{{ path('app_pokedex_edit', {'id': pokedex.id}) }}">edit</a>
    <br><br>
    <a href="{{ path('app_main') }}">Volver menu principal</a>  
    <br>

    {{ include('pokedex/_delete_form.html.twig') }}
{% endblock %}
